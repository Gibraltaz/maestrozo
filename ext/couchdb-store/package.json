{
  "name": "@maestrozo/couchdb-store",
  "version": "0.0.1",
  "description": "Maestrozo CouchDB store library",
  "author": "Dominique Parisot <dominique@gibraltaz.fr>",
  "license": "LGPL-3.0-or-later",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit --watch --pretty",
    "test": "vitest",
    "test:watch": "vitest --watch"
  },
  "devDependencies": {
    "@types/nconf": "^0.10.7",
    "@types/node": "^25.9.5",
    "nconf": "^0.13.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@maestrozo/core": "file:../../core",
    "@maestrozo/kernel": "file:../../kernel",
    "nano": "^11.0.7",
    "undici": "^8.11.2"
  }
}
